# ============================================================
#  GestProy — variables de entorno para Docker Compose
#  Copia este archivo como ".env" (queda gitignored) y ajusta
#  los valores. Si no creas ".env", compose usa los valores por
#  defecto del docker-compose.yml (aptos solo para pruebas locales).
# ============================================================

# Contraseña del usuario postgres dentro del contenedor de BD.
POSTGRES_PASSWORD=gestproy

# Clave de firma de los JWT de la cuenta admin (HMAC-SHA512).
# Usa una propia de al menos 64 caracteres aleatorios, por ejemplo:
#   openssl rand -base64 48
APP_JWT_SECRET=CAMBIA_ESTA_CLAVE_POR_UNA_ALEATORIA_DE_AL_MENOS_64_CARACTERES___
